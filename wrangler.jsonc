{
  // TanStack Start (SSR) on Cloudflare Workers, built by Nitro (`cloudflare-module` preset).
  //
  // Nitro owns the deployable Worker config. `vite build` emits:
  //   dist/server/index.mjs          -> the Worker (SSR + server functions)
  //   dist/client                    -> static assets (ASSETS binding)
  //   dist/server/wrangler.json      -> the REAL wrangler config (main + assets set by Nitro)
  //   .wrangler/deploy/config.json   -> redirect so plain `wrangler deploy` uses the file above
  //
  // Therefore this root file must NOT define `main` or `assets` — Nitro overrides them
  // (that was the source of the "Wrangler config main/assets is overridden" warnings and
  // the "dist/server/index.mjs was not found" failure when a stale path was hardcoded).
  //
  // Deploy:  npm run build && npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "component-ai-pro",
  "compatibility_date": "2026-08-20",
  // Safety net: if `wrangler deploy` is run on a fresh clone with no build output,
  // Wrangler builds first, which also generates the redirect config above.
  "build": { "command": "npm run build" },
  "observability": {
    "enabled": true
  }
}
